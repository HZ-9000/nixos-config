[accessibility]
ui_scale = 1.1

[backdrop]
enabled = true

[bar.main]
background_opacity = 0.2
center = ["group:clock"]
end = ["group:controls"]
font_family = "JetBrains Mono"
font_weight = 400
hover_highlight = false
margin_edge = 2
margin_ends = 6
position = "top"
shadow = false
start = ["group:system"]
thickness = 28
widget_spacing = 4

[[bar.main.capsule_group]]
fill = "#141414"
foreground = "#ffffff"
id = "system"
members = ["workspaces"]
opacity = 0.5
padding = 10
radius = 10
widget_spacing = 4

[[bar.main.capsule_group]]
fill = "#141414"
foreground = "#ffffff"
id = "clock"
members = ["clock"]
opacity = 0.5
padding = 10
radius = 10

[[bar.main.capsule_group]]
fill = "#141414"
foreground = "#ffffff"
id = "controls"
members = ["media", "volume", "battery", "session"]
opacity = 0.5
padding = 10
radius = 10
widget_spacing = 4

[idle.behavior.lock]
action = "lock"
enabled = true
timeout = 600

[idle.behavior.screen-off]
action = "screen_off"
enabled = true
timeout = 900

[lockscreen]
blurred_desktop = false
enabled = true
wallpaper = ""

[shell]
font_family = "JetBrains Mono"

[theme]
custom_palette = "OsakaJade"
mode = "dark"
source = "custom"

[theme.templates]
builtin_ids = ["gtk3", "gtk4"]
enable_builtin_templates = true

[wallpaper]
directory = "~/Pictures/wallpapers"
enabled = true

[wallpaper.default]
path = "~/Pictures/wallpapers/02.jpg"

[widget.clock]
font_weight = 700
format = "{:%H:%M}"

[widget.launcher]
enabled = false

[widget.media]
hide_when_no_media = true
title_scroll = "on_hover"

[widget.session]
color = "#a6b5b1"

[widget.volume]
show_label = true

[widget.workspaces]
active_pill_size = 2.2
inactive_pill_size = 1.0
label_source = "id"
show_labels = true
style = "minimal"
