input {
    keyboard {
        xkb {
            layout "us"
            options "grp:alt_caps_toggle"
        }
        repeat-delay 300
        numlock
    }
    touchpad {
        natural-scroll
    }
}

layout {
    gaps 6
    default-column-width { proportion 1.0; }
    border {
        width 2
        // colours come from theme.kdl
    }
    focus-ring { off; }
}

include "./monitor.kdl"
// Generated from the flake theme (vars/themes) by home/linux/gui/niri/default.nix.
include "./theme.kdl"
include "./noctalia-shell.kdl"
include "./spawn-at-startup.kdl"
include "./key-bindings.kdl"
include "./window-rules.kdl"
