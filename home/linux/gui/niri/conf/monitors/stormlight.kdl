// Monitor layout for stormlight.
//
// Outputs are matched by "make model serial" rather than connector name,
// since dock/MST connectors (DP-8, DP-13, ...) get renumbered between plugs.
// Run `niri msg outputs` to see names and supported modes.

// Left, portrait
output "Dell Inc. DELL U2724D 69TV4Z3" {
    mode "2560x1440@120.000"
    scale 1.0
    transform "90"
    position x=0 y=0
}

// Middle
output "Dell Inc. DELL U2724DE C7X7634" {
    mode "2560x1440@120.000"
    scale 1.0
    position x=1440 y=524
}

// Right, laptop panel
output "BOE NE135A1M-NY1 Unknown" {
    mode "2880x1920@120.000"
    scale 2.0
    position x=4000 y=789
}
