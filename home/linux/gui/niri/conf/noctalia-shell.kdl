// https://docs.noctalia.dev/noctalia/compositor-settings/niri/

window-rule {
    // Square Noctalia surfaces to match the tiled window bezels.
    geometry-corner-radius 0

    // Keep surface contents within the compositor's square geometry.
  clip-to-geometry true
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

// Show Noctalia's blurred wallpaper backdrop in niri overview.
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

// Keep Noctalia's native settings window at a practical size.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
}
